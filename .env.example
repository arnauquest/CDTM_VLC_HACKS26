# Local setup only. Application code will consume these settings when implemented.
# Copy to .env. Never commit real credentials.
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=3000
APP_BASE_URL=http://localhost:3000

# Proposed startup defaults. The backend must persist mode changes and enforce
# the current policy before delivery. auto still requires review for exceptions.
COMMUNICATION_MODE=manual
DEFAULT_COMMUNICATION_CHANNEL=browser_voice
DELIVERY_MODE=simulation
SQLITE_PATH=./var/sherpas.sqlite3
RECORDINGS_DIR=./var/recordings
AGENT_WORKSPACES_DIR=./var/agents

# OpenAI API is separate from the Codex ChatGPT login.
OPENAI_API_KEY=
OPENAI_DECISIONS_MODEL=gpt-6-luna
# Leave the conversation model blank until account availability is checked.
OPENAI_CONVERSATION_MODEL=
VOICE_ANALYSIS_PROVIDER=openai
VOICE_ANALYSIS_MODEL=gpt-audio-1.5

# ElevenLabs dashboard -> Developers -> API Keys.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Optional cheaper audio-analysis alternative; not required for OpenAI analysis.
GEMINI_API_KEY=
GEMINI_VOICE_ANALYSIS_MODEL=gemini-3.5-flash-lite

# Local agent executables; load Toni/activar-herramientas.zsh first.
AGENT_PROVIDER=codex
CODEX_BIN=codex
CLAUDE_BIN=claude
OPENCODE_BIN=opencode
AGENT_MAX_CONCURRENCY=2

# Supplied case files can be used without MCP authentication.
SHERPAS_CASES_DIR=../../referencias/sherpas/recursos-oficiales/cases
MCP_URL=https://mcp-hackathon.sherpaswealth.com/mcp
MCP_TOKEN=
# Optional Sherpas team proxy; independent of the MCP token.
LLM_PROXY_URL=https://llm-hackathon.sherpaswealth.com
TEAM_KEY=
