# Local backend configuration. Copy only if .env does not already exist.
# Never commit real credentials.
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=3000
APP_BASE_URL=http://localhost:3000

# Initial defaults for a fresh database. Persisted policy takes precedence.
# auto still requires review for content exceptions; manual requires approval.
COMMUNICATION_MODE=auto
DEFAULT_COMMUNICATION_CHANNEL=browser_voice
DELIVERY_MODE=simulation
SQLITE_PATH=./var/sherpas.sqlite3
RECORDINGS_DIR=./var/recordings
AGENT_WORKSPACES_DIR=./var/agents

# OpenAI API is separate from the Codex ChatGPT login.
# Primary for Decisions and the conversation LLM; secondary for temporary rate limits.
OPENAI_API_KEY=
OPENAI_API_KEY_FALLBACK=
OPENAI_RATE_LIMIT_FAILOVER_ENABLED=true
# Temporary fallback affinity; provider reset/retry headers take precedence.
OPENAI_RATE_LIMIT_COOLDOWN_SECONDS=30
OPENAI_RATE_LIMIT_MAX_ATTEMPTS=3
OPENAI_DECISIONS_MODEL=gpt-6-luna
# Provisional conservative routing threshold, not an evaluated calibration.
DECISIONS_RELEVANCE_THRESHOLD=0.2
# Verified with both configured accounts in streaming Chat Completions.
OPENAI_CONVERSATION_MODEL=gpt-6-luna
OPENAI_CONVERSATION_REASONING_EFFORT=none
# Acoustic tone analysis is pending a validated model. The future backend must
# report not_configured and keep transcript/self-report analysis available.
VOICE_ANALYSIS_PROVIDER=none
VOICE_ANALYSIS_MODEL=

# ElevenLabs dashboard -> Developers -> API Keys.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_WEBHOOK_SECRET=

# Optional cheaper audio-analysis alternative; not required for OpenAI analysis.
GEMINI_API_KEY=
GEMINI_VOICE_ANALYSIS_MODEL=gemini-3.5-flash-lite

# Local agent executables; load Toni/activar-herramientas.zsh first.
AGENT_PROVIDER=codex
CODEX_BIN=codex
CLAUDE_BIN=claude
OPENCODE_BIN=opencode
AGENT_MAX_CONCURRENCY=2
AGENT_TIMEOUT_MS=120000
# Optional; blank keeps the CLI provider's model default.
AGENT_MODEL=

# Supplied case files can be used without MCP authentication.
SHERPAS_CASES_DIR=../../referencias/sherpas/recursos-oficiales/cases
MCP_URL=https://mcp-hackathon.sherpaswealth.com/mcp
MCP_TOKEN=
# Optional Sherpas team proxy; independent of the MCP token.
LLM_PROXY_URL=https://llm-hackathon.sherpaswealth.com
TEAM_KEY=
